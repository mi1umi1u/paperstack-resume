{
  "name": "paperstack",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "离线运行、不上传数据的中文简历工具",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vite build && playwright test",
    "demo:gif": "node scripts/build-demo-gif.mjs",
    "fixtures:resumes": "node scripts/build-resume-corpus.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.8.69",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.49.0"
  }
}
